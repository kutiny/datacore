DATACORE_PASSWORD=change-me
SESSION_SECRET=
DATACORE_HOST=localhost
DATACORE_PORT=3737
# An engine is only enabled (dashboard card + deploy options + login chips) when
# its *_HOST is set. Unset the ones you do not use.
# Inside docker-compose use the service names (postgres/mysql/mariadb/mongo);
# for local runs point them at localhost.
POSTGRES_HOST=localhost
MYSQL_HOST=localhost
MARIADB_HOST=localhost
MONGO_HOST=localhost
# Override the internal connection port when the panel connects to a published
# port that differs from the image default.
#POSTGRES_CONN_PORT=5432
#MYSQL_CONN_PORT=3306
#MARIADB_CONN_PORT=3306
#MONGO_CONN_PORT=27017
# Published host ports (shown in the UI connection details).
POSTGRES_PORT=5432
MYSQL_PORT=3306
MARIADB_PORT=3306
MONGO_PORT=27017
POSTGRES_SUPERPASSWORD=datacore_pass
MYSQL_ROOT_PASSWORD=datacore_pass
MARIADB_ROOT_PASSWORD=datacore_pass
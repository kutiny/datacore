{
  "name": "datacore",
  "version": "1.0.0",
  "description": "Lightweight database management panel",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "lint-staged": {
    "*.js": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,css,html,yml,yaml}": "prettier --write"
  },
  "keywords": [
    "database",
    "management",
    "docker",
    "postgresql",
    "mysql",
    "mongodb",
    "mariadb"
  ],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.9.0",
      "onFail": "download"
    }
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "mariadb": "3.5.4",
    "mongodb": "^6.21.0",
    "mysql2": "^3.14.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "husky": "9.1.7",
    "lint-staged": "17.5.1",
    "prettier": "3.9.6"
  }
}
